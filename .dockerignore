# Dependencies & build outputs are regenerated inside the image.
node_modules
**/node_modules
**/dist
server/dist
web/dist

# Local SQLite databases and logs must never leak into the image.
**/data/*.db
**/data/*.db-journal
**/data/*.db-wal
**/data/*.db-shm
*.log

# Secrets & local env files (the app falls back to safe defaults).
.env
**/.env

# VCS / OS noise.
.git
.gitignore
.DS_Store
