# ============================================================
# 20FIT Shop Inventory — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# Supabase project — from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER-ONLY. Never expose to the browser.
# Set this in Vercel project env vars, not in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app (used for absolute links, QR, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (password-reset OTP) — from resend.com.
# Without RESEND_API_KEY the OTP flow still runs but codes are logged
# server-side instead of emailed (dev fallback). RESEND_FROM must be on a
# domain verified in Resend, e.g. "20FIT Shop <noreply@20fit.id>".
RESEND_API_KEY=
RESEND_FROM=
