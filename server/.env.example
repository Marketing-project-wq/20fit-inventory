# 20FIT Shop Inventory — backend configuration
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# Every variable below is OPTIONAL — the server falls back to the
# development defaults shown here when no .env is present, so a fresh
# clone runs with just `npm install && npm run seed && npm run dev`.
# Set real values (especially JWT_SECRET) before deploying to production.

# Port the API listens on.
PORT=4000

# Secret used to sign JWT auth tokens. CHANGE THIS IN PRODUCTION to a long,
# random string — anyone who knows it can forge login tokens.
JWT_SECRET=dev-secret-change-in-production

# Lifetime of an issued login token (any vercel/ms-style duration).
JWT_EXPIRES_IN=12h

# Path to the SQLite database file (created on first run / seed).
DB_PATH=./data/inventory.db

# Comma-separated list of allowed CORS origins for the web frontend.
# Leave unset to allow all origins (development convenience).
CORS_ORIGIN=http://localhost:5173
